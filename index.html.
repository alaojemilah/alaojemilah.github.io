  <style>
    :root {
      --navy: #142b4a;
      --blue: #3568d4;
      --light: #f5f7fb;
      --text: #263449;
      --muted: #65748b;
      --white: #ffffff;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      color: var(--text);
      background: var(--light);
      line-height: 1.7;
    }

    header {
      background: var(--navy);
      color: white;
      padding: 22px 7%;
    }

    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 18px;
      font-size: 14px;
    }

    .hero {
      padding: 80px 7%;
      background: var(--navy);
      color: white;
    }

    .hero-content { max-width: 760px; }

    .eyebrow {
      color: #a9c4ff;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 12px;
      font-weight: bold;
    }

    h1 {
      font-size: clamp(36px, 6vw, 58px);
      line-height: 1.15;
      margin: 14px 0;
    }

    .hero p {
      max-width: 650px;
      color: #e0e8f5;
      font-size: 17px;
    }

    .button {
      display: inline-block;
      margin: 12px 10px 0 0;
      padding: 11px 18px;
      border-radius: 7px;
      background: var(--blue);
      color: white;
      text-decoration: none;
      font-weight: bold;
    }

    .button.secondary {
      background: transparent;
      border: 1px solid #b7c9e8;
    }

    main {
      max-width: 1100px;
      margin: auto;
      padding: 25px 6% 60px;
    }

    section { padding: 30px 0; }

    h2 {
      color: var(--navy);
      font-size: 28px;
      margin-bottom: 8px;
    }

    .section-intro {
      color: var(--muted);
      margin-top: 0;
    }

    .skills, .projects {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
      margin-top: 22px;
    }

    .card {
      background: var(--white);
      border-radius: 12px;
      padding: 22px;
      border: 1px solid #e5eaf2;
    }

    .card h3 {
      color: var(--navy);
      margin-top: 0;
    }

    .card p {
      color: var(--muted);
      font-size: 14px;
    }

    .card a {
      color: var(--blue);
      font-weight: bold;
      text-decoration: none;
    }

    .tag {
      display: inline-block;
      background: #eaf0ff;
      color: #234caa;
      padding: 4px 9px;
      border-radius: 20px;
      font-size: 12px;
      margin: 3px 3px 3px 0;
    }

    .contact {
      background: white;
      border-radius: 12px;
      padding: 28px;
    }

    .contact a {
      color: var(--blue);
      overflow-wrap: anywhere;
    }

    footer {
      text-align: center;
      padding: 24px;
      color: var(--muted);
      font-size: 13px;
    }

    @media (max-width: 600px) {
      nav { align-items: flex-start; }
      nav a { margin-left: 0; margin-right: 12px; }
      .hero { padding-top: 55px; padding-bottom: 55px; }
    }
  </style>
